{
  "hosting": {
    "public": "_site",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ] }
    ]
  }
}
